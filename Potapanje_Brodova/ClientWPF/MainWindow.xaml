<Window x:Class="ClientWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Battleship Igra" Height="800" Width="900">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2C3E50" Offset="0"/>
            <GradientStop Color="LightSkyBlue" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2ECC71"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#27AE60"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#95a5a6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TablaStyle" TargetType="UniformGrid">
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <TextBlock Grid.Row="0" x:Name="StatusUnosa" Text="Postavite brodove..." Foreground="White" FontSize="17" HorizontalAlignment="Center" Margin="0 20 0 0" Height="Auto" Grid.ColumnSpan="2"/>
        <StackPanel Grid.Row="1" Margin="55">
            <Border Background="#34495E" CornerRadius="10" Margin="0,0,0,15" Padding="10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Igrač: " Foreground="LightSkyBlue" FontSize="16" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtImeIgraca" Text="Korisnik" Foreground="White" FontSize="16" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <TextBlock Text="Moja tabla" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Broj preostalih podmornica: " Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock x:Name="TxtPreostalePodmorniceMoje" Text="10" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="10">
                <CheckBox Visibility="Hidden"/>
            </StackPanel>
            <Border CornerRadius="5" Background="White" Padding="2" HorizontalAlignment="Center">
                <UniformGrid x:Name="MojaTablaGrid" Rows="10" Columns="10" Width="300" Height="300"/>
            </Border>

            <StackPanel x:Name="UnosPodmornicaPanel" Visibility="Visible" Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="H" Click="BtnSmer_Click" Tag="H" Width="50" Height="30" Margin="5" Style="{StaticResource ModernButton}"/>
                    <Button Content="V" Click="BtnSmer_Click" Tag="V" Width="50" Height="30" Margin="5" Style="{StaticResource ModernButton}"/>
                </StackPanel>
            </StackPanel>

            <Button x:Name="BtnPotvrdi" Content="POTVRDI RASPORED" Style="{StaticResource ModernButton}" Click="BtnPotvrdi_Click"
                    Height="40" Width="200" Margin="0,15,0,15" IsEnabled="False" FontWeight="Bold" Background="#E74C3C"/>
        </StackPanel>


        <StackPanel Grid.Column="1" Grid.Row="1" Margin="55" VerticalAlignment="Top">

            <Border Background="#34495E" CornerRadius="10" Margin="0,0,0,15" Padding="10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Igrač: " Foreground="LightSkyBlue" FontSize="16" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtImeProtivnika" Text="Protivnik" Foreground="White" FontSize="16" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            
            <TextBlock Text="Protivnička tabla " Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Broj preostalih podmornica: " Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock x:Name="TxtPreostalePodmornice" Text="10" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" />
            </StackPanel>
            

            <StackPanel Orientation="Horizontal" Margin="10">
                <CheckBox x:Name="CbSuperPotez" Content="Koristi Super potez (3x3)" IsEnabled="True"/>
            </StackPanel>
            <Border CornerRadius="5" 
            Background="White" 
            Padding="2" 
            HorizontalAlignment="Center"  
            Width="304" Height="304">
                <UniformGrid x:Name="ProtivnickaTablaGrid" 
                     Rows="10" Columns="10"/>
            </Border>
        </StackPanel>
        <StackPanel Orientation="Vertical" Margin="10">
            <TextBlock x:Name="TxtBrojPromasaja" Text="Uzastopni promašaji: 0" Foreground="Red" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>