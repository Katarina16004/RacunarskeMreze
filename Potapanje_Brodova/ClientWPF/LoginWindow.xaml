<Window x:Class="ClientWPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClientWPF"
        mc:Ignorable="d"
        Title="LoginWindow" Height="450" Width="450">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2C3E50" Offset="0"/>
            <GradientStop Color="LightSkyBlue" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2ECC71"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel VerticalAlignment="Center" Margin="30">
        <TextBlock Text="Dobrodošli u potapanje brodova!" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
        <TextBlock Text="Unesite vaše korisničko ime:" Foreground="White" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <TextBox Name="ImeTextBox" Height="35" FontSize="16" Padding="5" BorderThickness="0" Background="#F0F0F0" 
                 VerticalContentAlignment="Center" Margin="0,0,0,15"/>

        <Button Name="BtnPrijava" Content="PRIJAVI SE" Height="40" Background="#E74C3C" Foreground="White" 
                FontWeight="Bold" BorderThickness="0" Click="BtnPrijava_Click"  Cursor="Hand" Style="{StaticResource ModernButton}">
        </Button>
        <TextBlock Name="StatusTextBlock" Text="Čekamo na prijavu ostalih igrača..." 
               Foreground="White" FontSize="14" HorizontalAlignment="Center" 
               Margin="0,20,0,0" Visibility="Collapsed" FontStyle="Italic"/>
    </StackPanel>
</Window>
